# ---------------------------------------------------------------------------
# STAGER — environment
#
# Copy to .env.local and fill in. .env.local is gitignored and is the ONLY env
# file: the Prisma scripts read it too (via dotenv-cli), so there is no second
# .env to keep in sync.
#
#   cp .env.example .env.local
# ---------------------------------------------------------------------------


# --- Supabase: Database -----------------------------------------------------
# Supabase dashboard → Project Settings → Database → Connection string.
#
# DATABASE_URL — the POOLED connection (Transaction mode, port 6543). Used at
# runtime. Nothing needs adding to it: the pool size and TLS are set in
# pkg/db/prisma.ts. (`pgbouncer=true&connection_limit=1`, which older copies
# carry, were settings of Prisma's old engine; node-postgres ignores them.)
# Leave `sslmode` out: it would override the TLS setting. The connection is
# encrypted whenever the host is not local.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# DIRECT_URL — the DIRECT connection (Session mode, port 5432). Used only by
# `prisma migrate`, which needs to open a real session to run DDL.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Optional. Supabase's CA certificate (Database → Settings → SSL Configuration →
# Download certificate), so the server is verified as well as the link
# encrypted. The PEM text; its line breaks may be written as \n.
# DATABASE_SSL_CA=""


# --- Supabase: Auth ---------------------------------------------------------
# Supabase dashboard → Project Settings → API.
#
# The BARE ORIGIN only — no /rest/v1, no trailing path. The client appends its
# own /auth/v1 and /rest/v1 paths, so a suffix here sends sign-in to
# /rest/v1/auth/v1/token and Supabase answers "Invalid path specified in
# request URL". The app now refuses to boot on this, and `pnpm setup:check`
# names it, because for a while the login form reported it as a wrong password.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon public key>"

# Server-only. Never prefix this with NEXT_PUBLIC_ and never import it from a
# client component — pkg/config/env.server.ts is marked `server-only` so an
# accidental client import fails the build instead of leaking the key.
SUPABASE_SERVICE_ROLE_KEY="<service role key>"


# --- Admin bootstrap --------------------------------------------------------
# The email you created in Supabase → Authentication → Users. `pnpm db:seed`
# inserts this address into the AdminUser allowlist. Anyone not on that list is
# rejected from /admin even with a valid Supabase session.
ADMIN_EMAIL="you@stager.ge"
ADMIN_NAME="Site Owner"


# --- Vercel Blob (images) ---------------------------------------------------
# Vercel dashboard → Storage → your Blob store → Tokens.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_<store id>_<secret>"


# --- Resend (contact form email) — ALL OPTIONAL ------------------------------
# Leave these unset until your sending domain is verified in Resend. The site
# deploys and runs without them: a contact submission is written to the database
# first and the notification is a courtesy on top, so inquiries are never lost
# and are always readable in the dashboard. `pnpm setup:check` reports the state.
#
# resend.com → API Keys. The domain in MAIL_FROM must be verified in Resend.
# MAIL_FROM becomes REQUIRED as soon as RESEND_API_KEY is set — a key without a
# sender makes Resend reject every send.
# RESEND_API_KEY="re_<key>"
# MAIL_FROM="STAGER <noreply@stager.ge>"

# Where contact-form submissions are delivered. Optional — falls back to
# ADMIN_EMAIL. Can also be overridden per-site from the admin dashboard
# (Settings → Inquiry inbox), which takes precedence over both.
# CONTACT_INBOX_EMAIL="info@stager.ge"

# Whether contact-form submissions are stored and emailed. The live site always
# delivers. `pnpm dev` and Vercel previews (design.stager.ge, branch links) do
# not: they share the live database and inbox, so a test sent from them would
# reach the client as a real lead. Set to "on" to test the whole pipeline, and
# then only against a local database. See pkg/config/inquiry-delivery.ts.
# INQUIRY_DELIVERY="on"


# --- Site -------------------------------------------------------------------
# The PUBLIC, user-facing origin: canonical tags, OG URLs and the sitemap.
# Local: http://localhost:3000 — Production: https://stager.ge
#
# Safe to set to the final domain before its DNS resolves. On Vercel the server
# calls its own API via VERCEL_URL, not via this value, so an unresolved domain
# here cannot make the site render empty. See pkg/http/site-url.ts.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional, and never needed on Vercel. Forces the origin the SERVER uses for
# its own /api calls, ahead of both VERCEL_URL and NEXT_PUBLIC_SITE_URL: for a
# host other than Vercel where the server cannot reach its public address.
# (Not a loopback address on Vercel: nothing listens there. With Vercel
# Deployment Protection on, enable "Protection Bypass for Automation" instead;
# the server then sends VERCEL_AUTOMATION_BYPASS_SECRET with its own reads.)
# INTERNAL_API_ORIGIN="http://127.0.0.1:3000"

# Optional, local only. Switches on /api/dev/revalidate-probe, the endpoint
# tests/e2e/cache-invalidation.spec.ts uses to prove the edit→live loop without
# a Supabase account. It purges cache tags and never writes. Ignored entirely on
# Vercel, so it cannot be enabled for the live site.
# ENABLE_CACHE_PROBE="1"

# Random 32+ char string. Salts the IP hashes stored on inquiries and rate
# limits, so the raw addresses are never recoverable from the database.
#   openssl rand -hex 32
IP_HASH_SALT="<openssl rand -hex 32>"


# --- Daily job — Vercel, production only -------------------------------------
# Vercel calls /api/cron/daily once a day (vercel.json), sending this as a
# Bearer token. The job retries inquiry emails that failed, prunes old audit
# and rate-limit rows, and its query keeps a Free Supabase project from
# pausing. Any long random string, set in Vercel for Production. Unset, the job
# refuses every call (nothing breaks; nothing is retried or pruned either).
#   openssl rand -hex 32
# CRON_SECRET="<openssl rand -hex 32>"


# --- Error reporting (Sentry) — ALL OPTIONAL ---------------------------------
# sentry.io → a Next.js project → Settings → Client Keys (DSN). Unset, error
# reporting is off and the SDK is never even loaded; it is also always off in
# `pnpm dev`. Set it in Vercel for Production (and Preview, if wanted), then
# check it from the dashboard: Settings → Error reporting → Send a test error.
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@o<org-id>.ingest.<region>.sentry.io/<project-id>"
#
# Readable stack traces (source maps uploaded at build). Without these the
# build still succeeds; stack traces just read minified. Sentry → Settings →
# Organization Tokens.
# SENTRY_AUTH_TOKEN="sntrys_<token>"
# SENTRY_ORG="<org-slug>"
# SENTRY_PROJECT="<project-slug>"

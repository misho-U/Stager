# ---------------------------------------------------------------------------
# STAGER — environment
#
# Copy to .env.local and fill in. .env.local is gitignored and is the ONLY env
# file: the Prisma scripts read it too (via dotenv-cli), so there is no second
# .env to keep in sync.
#
#   cp .env.example .env.local
# ---------------------------------------------------------------------------


# --- Supabase: Database -----------------------------------------------------
# Supabase dashboard → Project Settings → Database → Connection string.
#
# DATABASE_URL — the POOLED connection (Transaction mode, port 6543). Used at
# runtime. The two query params matter: pgBouncer does not support prepared
# statements, and each serverless instance must hold at most one connection.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL — the DIRECT connection (Session mode, port 5432). Used only by
# `prisma migrate`, which needs to open a real session to run DDL.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"


# --- Supabase: Auth ---------------------------------------------------------
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon public key>"

# Server-only. Never prefix this with NEXT_PUBLIC_ and never import it from a
# client component — pkg/config/env.server.ts is marked `server-only` so an
# accidental client import fails the build instead of leaking the key.
SUPABASE_SERVICE_ROLE_KEY="<service role key>"


# --- Admin bootstrap --------------------------------------------------------
# The email you created in Supabase → Authentication → Users. `pnpm db:seed`
# inserts this address into the AdminUser allowlist. Anyone not on that list is
# rejected from /admin even with a valid Supabase session.
ADMIN_EMAIL="you@stager.ge"
ADMIN_NAME="Site Owner"


# --- Vercel Blob (images) ---------------------------------------------------
# Vercel dashboard → Storage → your Blob store → Tokens.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_<store id>_<secret>"


# --- Resend (contact form email) --------------------------------------------
# resend.com → API Keys. The domain in MAIL_FROM must be verified in Resend.
RESEND_API_KEY="re_<key>"
MAIL_FROM="STAGER <noreply@stager.ge>"
# Where contact-form submissions are delivered. Can be overridden per-site from
# the admin dashboard (Settings → Inquiry inbox).
CONTACT_INBOX_EMAIL="info@stager.ge"


# --- Site -------------------------------------------------------------------
# Absolute origin. Needed because server components fetch their own /api routes
# and because sitemap/canonical/OG URLs must be absolute.
# Local: http://localhost:3000 — Production: https://stager.ge
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Random 32+ char string. Salts the IP hashes stored on inquiries and rate
# limits, so the raw addresses are never recoverable from the database.
#   openssl rand -hex 32
IP_HASH_SALT="<openssl rand -hex 32>"
